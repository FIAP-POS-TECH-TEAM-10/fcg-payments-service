{
  "family": "fcg-payments-service-task",
  "networkMode": "bridge",
  "requiresCompatibilities": [
    "EC2"
  ],
  "cpu": "512",
  "memory": "512",
  "taskRoleArn": "arn:aws:iam::915153720516:role/fcg-payments-service-ecs-task-role",
  "volumes": [
    {
      "name": "payments-data"
    }
  ],
  "containerDefinitions": [
    {
      "name": "fcg-payments-service-container",
      "image": "915153720516.dkr.ecr.sa-east-1.amazonaws.com/fcg-payments-service:latest",
      "cpu": 256,
      "memory": 256,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5003,
          "hostPort": 5003,
          "protocol": "tcp"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "payments-data",
          "containerPath": "/data"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:5003/health || exit 1"],
        "interval": 10,
        "timeout": 5,
        "retries": 5,
        "startPeriod": 30
      },
      "environment": [
        {
          "name": "ConnectionStrings__DefaultConnection",
          "value": "Data Source=/data/payments.db"
        },
        {
          "name": "ASPNETCORE_ENVIRONMENT",
          "value": "Production"
        },
        {
          "name": "ASPNETCORE_URLS",
          "value": "http://+:5003"
        },
        {
          "name": "DOTNET_SYSTEM_GLOBALIZATION_INVARIANT",
          "value": "1"
        },
        {
          "name": "Messaging__Provider",
          "value": "Sqs"
        },
        {
          "name": "AWS__Region",
          "value": "sa-east-1"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fcg-payments-service",
          "awslogs-region": "sa-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    },
    {
      "name": "fcg-payments-service-worker",
      "image": "915153720516.dkr.ecr.sa-east-1.amazonaws.com/fcg-payments-service:worker-latest",
      "cpu": 128,
      "memory": 128,
      "essential": false,
      "dependsOn": [
        {
          "containerName": "fcg-payments-service-container",
          "condition": "HEALTHY"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "payments-data",
          "containerPath": "/data"
        }
      ],
      "environment": [
        {
          "name": "ConnectionStrings__DefaultConnection",
          "value": "Data Source=/data/payments.db"
        },
        {
          "name": "DOTNET_SYSTEM_GLOBALIZATION_INVARIANT",
          "value": "1"
        },
        {
          "name": "Messaging__Provider",
          "value": "Sqs"
        },
        {
          "name": "AWS__Region",
          "value": "sa-east-1"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fcg-payments-service",
          "awslogs-region": "sa-east-1",
          "awslogs-stream-prefix": "worker"
        }
      }
    }
  ]
}